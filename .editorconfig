# Editor settings. The decompilation keeps its upstream style; these rules only describe
# what every file already follows, plus the platform layer's indentation.
root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{c,h,sh,mk,md,txt,cmake,json,yml,yaml}]
end_of_line = lf

[*.ps1]
end_of_line = crlf

[{src/platform/**,include/platform/**}.{c,h}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 110

[CMakeLists.txt]
indent_style = space
indent_size = 4
